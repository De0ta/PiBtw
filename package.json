  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/De0ta/PiBtw.git"
  },
  "homepage": "https://github.com/De0ta/PiBtw#readme",
  "files": [
    "srcs",
    "prompts",
    "config.json",
    "README.md",
    "README.zh-CN.md",
    "UPSTREAM.md",
    "banner.png",
    "preview.jpg"
  ],
